# Template for .env. Copy this file to .env and fill in the values.
#
#     cp .env.stub .env
#
# .env is git-ignored and holds every secret used by the container.
# Keep the values in this file empty.

# Agent token from your Buildkite organization's "Agents" page.
BUILDKITE_AGENT_TOKEN=

# Base64-encoded SSH private key that Documenter.jl uses to push built
# documentation to the gh-pages branch. Generate it with DocumenterTools.genkeys.
DOCUMENTER_KEY=
